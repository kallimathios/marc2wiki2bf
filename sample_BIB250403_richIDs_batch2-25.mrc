1612iContains (expression)aMozart, Wolfgang Amadeus,d1756-1791.tZauberflöte.pZum Leiden bin ich auserkoren.lFrench.12iContains (expression)aMozart, Wolfgang Amadeus,d1756-1791.tZauberflöte.pHölle Rache.lFrench.2 aOrchestre de l'association des concerts Colonne,eperformer.0http://id.loc.gov/authorities/names/n850761872 aOpéra de Paris.bOrchestre,eperformer.0http://id.loc.gov/authorities/names/n830662862 aOrchestre des concerts Lamoureux,eperformer.0http://id.loc.gov/authorities/names/n8212265602aSouvenirs de la belle époque02aAirs d'opéras  aRobert Baxter collection  aSUL/MUSIC/catalogedby/Flourish-WS/202411  aSUL/MUSIC/gift/kevkishi/20241205/Baxter  b36105234613805cMCD 74373n2lMusic PAGE-MU (MUS-PAGE-MU)  aC0bSTFffs85760d1f-3d40-413d-b41c-35b08f9fcb08i34e8ae6e-ef86-4513-b707-1d1bea8abb6509377njm a22013217i in0000023218620250403135052.0m     o  h        sz zunnnnnuneucr nnannnuuuuu241022p19971983enksgnn o         n ger d0 aGBAJY84131010 aGBAJY84131020 aGBAJY84131030 aGBAJY84131040 aGBAJY84131050 aGBAJY84131060 aGBAJY84131070 aGBAJY84131080 aGBAJY84131090 aGBAJY84131100 aGBAJY84131110 aGBAJY84131120 aGBAJY84131130 aGBAJY84131140 aGBAJY84131150 aGBAJY84131160 aGBAJY84131170 aGBAJY84131180 aGBAJY84132010 aGBAJY84132020 aGBAJY84132030 aGBAJY84132040 aGBAJY84132050 aGBAJY84132060 aGBAJY84132070 aGBAJY84132140 aGBAJY84132130 aGBAJY84132120 aGBAJY84132110 aGBAJY84132100 aGBAJY84132090 aGBAJY841320802a00602458157093bHyperion20a19831122a19831124  anmon1463322714  a(OCoLC)1463322714  aNAXOSbengerdaepncNAXOSdOCLCOdCStdUtOrBLW1 aSchubert, Franz,d1797-1828,ecomposer.0http://id.loc.gov/authorities/names/n500005611https://id.oclc.org/worldcat/entity/E39PBJxRJ8yWBjc8wcBR73vGpP10aSongs.kSelections0http://id.loc.gov/authorities/names/n8108963514aThe songmakers' almanac Schubertiade /cSchubert30aSchubertiade 1aLondon, England 